{
  "name": "garmin-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --watch --env-file-if-exists=.env server.mjs",
    "garmin:check": "node --env-file-if-exists=.env scripts/check-garmin.mjs",
    "garmin:sync": "node --env-file-if-exists=.env scripts/sync-garmin.mjs",
    "test": "node --test test/*.test.mjs"
  }
}
